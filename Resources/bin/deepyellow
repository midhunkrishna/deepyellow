#!/bin/sh
# deepyellow: command line entry point shipped inside DeepYellow.app.
# Resolves its own symlink chain, then runs the app binary in CLI mode.
set -eu

self=$0
while [ -L "$self" ]; do
    dir=$(cd -P "$(dirname "$self")" && pwd)
    target=$(readlink "$self")
    case $target in
        /*) self=$target ;;
        *) self=$dir/$target ;;
    esac
done
here=$(cd -P "$(dirname "$self")" && pwd)

# here is .../DeepYellow.app/Contents/Resources/bin
exec "$here/../../MacOS/DeepYellow" --cli "$@"
